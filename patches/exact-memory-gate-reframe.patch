 acceptance:
-  exact_memory_accuracy:
-    defensible: [0.70, 0.80]
-    acceptable_max: 0.85
-    red_flag_at: 0.90              # task already solved by existing models
+  exact_memory:
+    # Per fact type, exact-memory condition, n >= statistics.min_cell_size.
+    # A high exact-memory baseline is DESIRABLE for a memory-degradation study: it
+    # makes recurrent failures attributable to compression, not to baseline task
+    # incompetence. There is deliberately NO upper bound — the old red_flag_at:
+    # 0.90 imported a benchmark-hardness criterion that does not apply here.
+    # Validity (not accuracy) is guarded by target_removed_validity.
+    retrievability_min: 0.85        # PASS  — the model demonstrably does the task in-window
+    soft_floor: 0.70               # 0.70-0.85 -> WARN "baseline soft; degradation magnitude confounded"
+                                   # < 0.70   -> FAIL "not measuring memory"
+  target_removed_validity:
+    # From the forced-baseline diagnostic (protocol/forced_baseline_diagnostic.md):
+    # with the target sentence removed but the forced-answer instruction, question
+    # and distractors kept, a valid fact type collapses to near chance — the target
+    # must be doing the work.
+    max_removed_forced_accuracy: 0.30          # free-response types
+    max_removed_forced_accuracy_two_way: 0.65  # temporal / any 2-way question
+    min_present_minus_removed: 0.40
+    validated:
+      numerical:        {removed_forced_recurrent: 0.00, status: PASS}
+      entity-attribute: {removed_forced_recurrent: 0.06, status: PASS}
+      multi-hop:        {removed_forced_recurrent: 0.00, status: PASS}
+      contradictory:    {removed_forced_recurrent: 0.00, status: PASS}
+      temporal:         {status: PENDING}   # question-order repair (open_decisions #7b) awaiting 72-trial validation
   require_threshold_locked: true
   require_threshold_clears_window: true
   require_matched_design: true
